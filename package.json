{
  "name": "mealscount",
  "version": "1.0.0",
  "description": "MealsCount Frontend",
  "scripts": {
    "watch": "NODE_OPTIONS=--openssl-legacy-provider webpack --watch",
    "build": "NODE_OPTIONS=--openssl-legacy-provider webpack",
    "postinstall": "python generate_state_json.py",
    "local_dev": "concurrently \"npm run watch\" \"FLASK_ENV=development venv/bin/python server.py\"",
    "docker_dev": "concurrently \"npm run watch\" \"gunicorn server:app\"",
    "start": "NODE_OPTIONS=--openssl-legacy-provider webpack-dev-server --config ./webpack.config.js --mode development",
    "clean": "rm -rf dist/ && rm -rf node_modules/"
  },
  "author": "Nikolaj Baer",
  "license": "MIT",
  "dependencies": {
    "@popperjs/core": "^2.0.6",
    "autoprefixer": "^9.6.1",
    "axios": "^1.20.0",
    "babel-loader": "^8.0.6",
    "braces": "^3.0.2",
    "chroma-js": "^2.1.0",
    "concurrently": "^5.2.0",
    "d3": "^5.15.0",
    "d3-scale-chromatic": "^1.5.0",
    "esm": "^3.2.25",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.27",
    "minimist": "^1.2.7",
    "papaparse": "^5.2.0",
    "popper.js": "^1.15.0",
    "postcss-loader": "^3.0.0",
    "sass": "^1.49.9",
    "sass-loader": "^7.3.1",
    "us": "^2.0.0",
    "v-tooltip": "^2.0.3",
    "vue-faq-accordion": "^1.3.0",
    "vue-gtag": "^1.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "bootstrap": "^4.3.1",
    "css-loader": "^3.0.0",
    "file-loader": "^4.3.0",
    "html-webpack-plugin": "^3.2.0",
    "jquery": "^3.5.1",
    "style-loader": "^0.23.1",
    "topojson": "^3.0.2",
    "us-atlas": "^3.0.0",
    "vue": "^2.6.10",
    "vue-loader": "^15.7.1",
    "vue-router": "^3.1.3",
    "vue-template-compiler": "^2.6.10",
    "vuex": "^3.1.1",
    "webpack": "^4.41.6",
    "webpack-cli": "^3.3.11",
    "webpack-dev-server": "^3.11.0"
  },
  "engines": {
    "node": "14.x"
  }
}
